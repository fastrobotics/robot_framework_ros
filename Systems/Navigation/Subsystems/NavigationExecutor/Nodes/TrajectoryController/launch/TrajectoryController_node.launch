<?xml version="1.0"?>
<launch>
<arg name="robot_namespace" default="/"/> 
<arg name="verbosity_level" default="NOTICE"/>
<arg name="topic_pose_input" default="/" />
<arg name="topic_command_throttle_input" default="/"/>
<arg name="topic_command_robot_output" default="/" />
<node name="nodeTrajectoryController" pkg="robot_framework_ros" type="nodeTrajectoryController"  output="screen" clear_params="true">
    <param name="robot_namespace" value="$(arg robot_namespace)"/>
    <param name="verbosity_level"       value="$(arg verbosity_level)"/>
    <param name="loop1_rate" value="40.0" /> <!-- General Update.  Check and publish new Outputs -->
    <!-- Input Topics -->
    <param name="topic_pose_input" value="$(arg topic_pose_input)"/>
    <param name="topic_command_throttle_input" value="$(arg topic_command_throttle_input)"/>
    <!-- Output Topics -->
    <param name="topic_command_robot_output" value="$(arg topic_command_robot_output)"/>
    
    
    
    
</node>
</launch>