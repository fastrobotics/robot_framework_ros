<?xml version="1.0"?>
<launch>
    <arg name="robot_namespace" value="/test" />
    <group ns="test">
        <node type="rviz" name="rviz" pkg="rviz" args="-d $(find robot_framework_ros)/Systems/Pose/Subsystems/InertialSensor/Nodes/IMU/test/test_rviz.rviz" />
        <node pkg="tf2_ros" type="static_transform_publisher" name="link1_broadcaster" args="0 0 0 0 3.14159 0 base_link base_link/imu" />
         <node pkg="imu_transformer" type="imu_transformer_node" name="imu_transformer" output="screen">
            <!-- Remap to your actual source IMU topic -->
            <remap from="imu_in/data" to="imu"/>
            <remap from="imu_in/mag" to="magnetometer"/>
            
            <!-- Remap to your desired output IMU topic -->
            <remap from="imu_out/data" to="transformed_imu"/>
            <remap from="imu_out/mag" to="transformed_imu_magnetometer"/>
            
            <!-- Target frame you want the data to be expressed in -->
            <param name="target_frame" value="base_link"/>
        </node>
        <include file="$(find robot_framework_ros)/Systems/Pose/Subsystems/InertialSensor/Nodes/IMU/launch/IMU_node.launch">
            <arg name="robot_namespace" value="$(arg robot_namespace)"/>
            <!-- Input Topics -->
            <!-- Output Topics -->
        </include>
        <test test-name="test_nodeIMU" pkg="robot_framework_ros" type="test_nodeIMU"/>
    </group>
   
</launch>