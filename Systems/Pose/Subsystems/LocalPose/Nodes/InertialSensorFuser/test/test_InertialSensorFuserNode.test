<?xml version="1.0"?>
<!-- ' @compare_tag Node-LaunchTestFile  v0.1 -->
<launch>
    <arg name="robot_namespace" value="/test" />
    <arg name="verbosity_level" value="NOTICE"/>
    <group ns="test">
        <include file="$(find robot_framework_ros)/Systems/Pose/Subsystems/LocalPose/Nodes/InertialSensorFuser/launch/InertialSensorFuser_node.launch">
            <arg name="robot_namespace" value="$(arg robot_namespace)"/>
            <arg name="verbosity_level" value="$(arg verbosity_level)"/>
            <!-- Input Topics -->
            <arg name="topic_imu1_input" value="imu1"/>
            <!-- Output Topics -->
            <arg name="topic_machine_inertial_output" value="imu"/>
        </include>  
        <test test-name="test_nodeInertialSensorFuser" pkg="robot_framework_ros" type="test_nodeInertialSensorFuser"/>
    </group>
   
</launch>
